# Grafana Cloud Faro — Frontend Observability app "faro-poc"
# Collector URL incl. app key (public by design: ships in the browser bundle)
NUXT_PUBLIC_FARO_URL=https://faro-collector-prod-eu-west-2.grafana.net/collect/<appKey>

# Stack URL for the dashboard (not used by the app, kept for reference)
GRAFANA_STACK_URL=https://<name>.grafana.net

# Logical environment tag sent with every beacon: local | preview | production
NUXT_PUBLIC_FARO_ENVIRONMENT=local

# Hero film (optional). Any https URL that serves an MP4 with Range support:
# R2, S3+CloudFront, Bunny, Netlify — a plain file is enough, the browser
# streams it progressively by itself. Empty leaves the hero on its still.
NUXT_PUBLIC_SHOWREEL_URL=
